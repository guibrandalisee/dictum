{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Dictum",
    "version": "0.1.0",
    "identifier": "com.guisb.dictum",
    "build": {
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build",
        "devUrl": "http://localhost:1420",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "Dictum",
                "width": 880,
                "height": 640,
                "minWidth": 720,
                "minHeight": 520,
                "resizable": true,
                "fullscreen": false,
                "decorations": false,
                "transparent": false,
                "visible": true,
                "center": true
            },
            {
                "label": "overlay",
                "title": "Dictum overlay",
                "url": "index.html#overlay",
                "width": 280,
                "height": 64,
                "resizable": false,
                "decorations": false,
                "transparent": true,
                "alwaysOnTop": true,
                "skipTaskbar": true,
                "focus": false,
                "visible": false,
                "shadow": false,
                "acceptFirstMouse": false
            }
        ],
        "security": {
            "csp": "default-src 'self'; img-src 'self' data: asset: https://asset.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
        },
        "withGlobalTauri": false
    },
    "bundle": {
        "active": true,
        "targets": [
            "nsis"
        ],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.ico"
        ],
        "windows": {
            "webviewInstallMode": {
                "type": "embedBootstrapper"
            }
        },
        "category": "Productivity",
        "shortDescription": "Dictum — push-to-talk dictation using local Whisper.",
        "longDescription": "Dictum is a background utility that records audio while a global hotkey is held and pastes the local Whisper transcription into the active text field."
    }
}